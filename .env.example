# Server-side AI provider key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional server-side Gemini key.
GEMINI_API_KEY=your_gemini_api_key_here

# Public deployment URL used for OpenRouter attribution and self-referential links.
APP_URL=https://thesisverse.dpdns.org

# Frontend-only setting for a separate Render Static Site.
# Leave empty for the current single-service deployment.
VITE_API_BASE_URL=https://thesis-verse.onrender.com
